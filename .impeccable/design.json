			"description": "Dot, name, category-hue meter (red when over), spent/planned, remaining.",
			"html": "<button class=\"ds-crow\"><span class=\"ds-cname\"><i class=\"ds-dot\" style=\"background:oklch(0.68 0.13 220)\"></i>Groceries</span><span class=\"ds-cbar\"><i style=\"width:68%;background:oklch(0.68 0.13 220)\"></i></span><span class=\"ds-camt\"><b>$175.21</b> left</span></button><button class=\"ds-crow\"><span class=\"ds-cname\"><i class=\"ds-dot\" style=\"background:oklch(0.68 0.13 190)\"></i>Entertainment</span><span class=\"ds-cbar\"><i style=\"width:100%;background:var(--destructive,oklch(0.575 0.215 26))\"></i></span><span class=\"ds-camt ds-over\">$69.53 over</span></button>",
			"css": ".ds-crow{display:grid;grid-template-columns:12rem 1fr 8rem;align-items:center;gap:16px;width:560px;padding:12px 20px;border:0;border-bottom:1px solid var(--border,oklch(0.918 0.005 264));background:var(--card,oklch(1 0 0));color:var(--foreground,oklch(0.205 0.012 264));font:400 14px/1.4 \"Inter Variable\",ui-sans-serif,system-ui,sans-serif;text-align:left;cursor:pointer;transition:background-color .15s}.ds-crow:hover,.ds-crow:focus-visible{outline:none;background:color-mix(in oklch,var(--muted,oklch(0.957 0.005 264)) 60%,transparent)}.ds-cname{display:flex;align-items:center;gap:10px;font-weight:500}.ds-dot{width:8px;height:8px;border-radius:9999px}.ds-cbar{height:6px;border-radius:9999px;background:var(--track,oklch(0.935 0.005 264));overflow:hidden}.ds-cbar i{display:block;height:100%;border-radius:9999px;transition:width .5s ease-out}.ds-camt{text-align:right;font-variant-numeric:tabular-nums;color:var(--muted-foreground,oklch(0.515 0.016 264))}.ds-camt b{font-weight:500;color:var(--foreground,oklch(0.205 0.012 264))}.ds-over{font-weight:500;color:var(--destructive,oklch(0.575 0.215 26))}"
		}
