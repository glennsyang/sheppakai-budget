			"refersTo": "stat-cell",
			"description": "One panel of 1px-gap divided KPI cells; tone only for money state.",
			"html": "<dl class=\"ds-strip\"><div class=\"ds-cell\"><dt>Discretionary used</dt><dd class=\"ds-fig ds-pos\">53%</dd><div class=\"ds-m\"><i class=\"ds-pos-bg\" style=\"width:53%\"></i></div></div><div class=\"ds-cell\"><dt>Recurring burden</dt><dd class=\"ds-fig ds-warn\">48%</dd><div class=\"ds-m\"><i class=\"ds-warn-bg\" style=\"width:48%\"></i></div></div><div class=\"ds-cell\"><dt>Total savings</dt><dd class=\"ds-fig\">$132,437.07</dd></div></dl>",
			"css": ".ds-strip{display:flex;gap:1px;margin:0;overflow:hidden;border:1px solid var(--border,oklch(0.918 0.005 264));border-radius:16px;background:var(--border,oklch(0.918 0.005 264));box-shadow:var(--elev-sm,0 1px 2px 0 oklch(0.2 0.02 264/.04));font-family:\"Inter Variable\",ui-sans-serif,system-ui,sans-serif}.ds-cell{flex:1;display:flex;flex-direction:column;gap:4px;padding:20px;background:var(--card,oklch(1 0 0))}.ds-cell dt{font-size:12px;color:var(--muted-foreground,oklch(0.515 0.016 264))}.ds-fig{margin:0;font-size:20px;font-weight:600;letter-spacing:-.025em;font-variant-numeric:tabular-nums;color:var(--foreground,oklch(0.205 0.012 264))}.ds-pos{color:var(--positive,oklch(0.545 0.135 156))}.ds-warn{color:var(--warning,oklch(0.6 0.14 62))}.ds-m{height:4px;margin-top:4px;border-radius:9999px;background:var(--track,oklch(0.935 0.005 264));overflow:hidden}.ds-m i{display:block;height:100%;border-radius:9999px;transition:width .5s ease-out}.ds-pos-bg{background:var(--positive,oklch(0.545 0.135 156))}.ds-warn-bg{background:var(--warning,oklch(0.6 0.14 62))}"
		},
		{
			"name": "Category Row",
