			"css": ".ds-nav{display:flex;flex-direction:column;gap:4px;width:220px;padding:8px;background:var(--sidebar,oklch(0.958 0.005 264))}.ds-nav-item{display:flex;align-items:center;gap:8px;height:32px;padding:8px;border-radius:10px;color:var(--sidebar-foreground,oklch(0.32 0.012 264));font:400 14px/1 \"Inter Variable\",ui-sans-serif,system-ui,sans-serif;text-decoration:none;cursor:pointer;transition:background-color .15s}.ds-nav-item svg{color:var(--muted-foreground,oklch(0.515 0.016 264))}.ds-nav-item:hover{background:var(--sidebar-accent,oklch(0.925 0.007 264));color:var(--sidebar-accent-foreground,oklch(0.18 0.012 264))}.ds-nav-on{background:var(--sidebar-accent,oklch(0.925 0.007 264));color:var(--sidebar-accent-foreground,oklch(0.18 0.012 264));font-weight:500}.ds-nav-on svg{color:var(--primary,oklch(0.51 0.2 270))}"
