		{
			"name": "Panel",
			"kind": "card",
			"refersTo": "panel",
			"description": "The one container: 16px, hairline, elev-sm; sentence-case title, no icon.",
			"html": "<section class=\"ds-panel\"><h3 class=\"ds-panel-title\">Monthly overview</h3><p class=\"ds-panel-desc\">Income less everything spent.</p><div class=\"ds-panel-row\"><span>Income</span><span>$4,896.26</span></div><div class=\"ds-panel-row\"><span>Discretionary spent</span><span>−$1,073.12</span></div></section>",
			"css": ".ds-panel{width:360px;padding:24px;border:1px solid var(--border,oklch(0.918 0.005 264));border-radius:16px;background:var(--card,oklch(1 0 0));color:var(--card-foreground,oklch(0.205 0.012 264));box-shadow:var(--elev-sm,0 1px 2px 0 oklch(0.2 0.02 264/.04),0 2px 8px -2px oklch(0.2 0.02 264/.06));font-family:\"Inter Variable\",ui-sans-serif,system-ui,sans-serif}.ds-panel-title{margin:0;font-size:16px;font-weight:600;letter-spacing:-.025em}.ds-panel-desc{margin:6px 0 16px;font-size:14px;color:var(--muted-foreground,oklch(0.515 0.016 264))}.ds-panel-row{display:flex;justify-content:space-between;padding:6px 0;font-size:14px;font-variant-numeric:tabular-nums}.ds-panel-row span:first-child{color:var(--muted-foreground,oklch(0.515 0.016 264))}"
