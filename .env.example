# -----------------------------------------------------------------------------
# App runtime — validated in src/env.ts unless noted otherwise. See
# docs/ENVIRONMENT.md for the full reference (subsystem, where each is set, etc).
# -----------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=local.db
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_BASE_URL=http://localhost
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_ADDRESS=noreply@example.com
CRON_SECRET=your_cron_secret_here
ADMIN_USER_IDS=your_admin_user_id_here
# Only these emails can sign in (exact, case-insensitive). Required in production.
ALLOWED_EMAILS=you@example.com
AUTH_ALERTS_URL=https://ntfy.sh/your-auth-alerts-topic
BUDGET_ALERTS_URL=https://ntfy.sh/your-budget-alerts-topic
SENTRY_DSN=https://your_key@your_org.ingest.us.sentry.io/your_project_id
# Optional. Read raw from process.env, not through src/env.ts (see
# src/lib/server/logger.ts). One of: debug | info | warn | error.
# Defaults to debug in dev, info in production.
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CI / infra only — NOT read by the app itself, only by GitHub Actions / flyctl.
# -----------------------------------------------------------------------------
# Used by monthly-cron.yml / weekly-cron.yml to curl the deployed app. Not the same
# thing as BETTER_AUTH_BASE_URL, which the app itself uses.
APP_URL=http://localhost
# Used by flyctl in fly-deploy.yml / backup-database.yml.
FLY_API_TOKEN=your_fly_api_token_here
# GitHub Actions build secret only, passed to `flyctl deploy --build-secret` so the
# Dockerfile's build stage can upload source maps (see vite.config.ts). Do not
# `fly secrets set` this.
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
# GitHub Actions secret for backup-database.yml — encrypts/decrypts the nightly SQLite
# dump. See docs/BACKUP_RESTORE.md.
BACKUP_ENCRYPTION_PASSPHRASE=your_backup_encryption_passphrase_here
